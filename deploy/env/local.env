# AIM 本地 Docker Compose 默认环境。
# 仅用于开发；生产请复制 prod.example.env 到服务器本地并替换所有 CHANGE_ME。

AIM_ENV_FILE=../env/local.env
AIM_CONFIG_DIR=../config/local
COMPOSE_PROJECT_NAME=aim

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

AIM_GATEWAY_NODE_ID=0

# AIM etcd 注册中心（本地单节点）
ETCD_LISTEN_CLIENT_URLS=http://0.0.0.0:2379
ETCD_ADVERTISE_CLIENT_URLS=http://etcd:2379

SEAWEED_ACCESS_KEY=aim
SEAWEED_SECRET_KEY=aim-secret
SEAWEED_BUCKET=aim-attachments
SEAWEED_REGION=us-east-1
SEAWEED_S3_ENDPOINT=http://seaweed-s3:8333

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

AIM_API_HOST=localhost
AIM_FILES_HOST=files.localhost
