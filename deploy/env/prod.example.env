# AIM 生产环境变量模板。
# 不要把真实生产 env 提交仓库；部署时复制为 /etc/aim/aim.env 并替换所有 CHANGE_ME。

AIM_ENV_FILE=/etc/aim/aim.env
AIM_CONFIG_DIR=/etc/aim/config
COMPOSE_PROJECT_NAME=aim

POSTGRES_USER=aim_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

AIM_GATEWAY_NODE_ID=0

# etcd 注册中心由 deploy/compose/base.yaml 内置提供（服务名 etcd, 容器内端口 2379）。
# 所有 AIM 服务的 Etcd.Hosts 都已固定为 etcd:2379,不需要也无法通过 env 调整。
# 如果未来要接外部 etcd 集群,请修改 deploy/compose/base.yaml（或新增 prod.yaml 服务）以及
# deploy/config/prod.example/*.yaml 中的 Etcd.Hosts。

SEAWEED_ACCESS_KEY=aim-prod
SEAWEED_SECRET_KEY=CHANGE_ME_SEAWEED_SECRET_KEY
SEAWEED_BUCKET=aim-attachments
SEAWEED_REGION=us-east-1
SEAWEED_S3_ENDPOINT=http://seaweed-s3:8333

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
GF_USERS_ALLOW_SIGN_UP=false

# 反向代理 / TLS 终止由宿主或集群侧负责，aim 容器不再内置反代。
# 客户端实际访问的附件域名必须与 deploy/config/<env>/attachment.yaml 中
# Seaweed.PublicEndpoint 保持一致（建议用同一变量名在外部反代里消费）。
