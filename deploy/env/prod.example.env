# AIM 生产环境变量模板。
# 不要把真实生产 env 提交仓库；部署时复制为 /etc/aim/aim.env 并替换所有 CHANGE_ME。

AIM_ENV_FILE=/etc/aim/aim.env
AIM_CONFIG_DIR=/etc/aim/config
COMPOSE_PROJECT_NAME=aim

POSTGRES_USER=aim_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

AIM_GATEWAY_NODE_ID=0

# 生产 etcd 注册中心（3 节点集群）
ETCD_LISTEN_CLIENT_URLS=http://0.0.0.0:2379
ETCD_ADVERTISE_CLIENT_URLS=http://etcd1:2379
ETCD_NAME=etcd1
ETCD_INITIAL_CLUSTER=etcd1=http://etcd1:2380,etcd2=http://etcd2:2380,etcd3=http://etcd3:2380
ETCD_INITIAL_ADVERTISE_PEER_URLS=http://etcd1:2380

# 生产 etcd 鉴权 / TLS（凭证从 Secret / Vault 注入；本地 / dev 不开）
ETCD_USERNAME=CHANGE_ME_ETCD_USER
ETCD_PASSWORD=CHANGE_ME_ETCD_PASSWORD
ETCD_CERT_FILE=/etc/etcd/certs/etcd.pem
ETCD_KEY_FILE=/etc/etcd/certs/etcd-key.pem
ETCD_CA_FILE=/etc/etcd/certs/ca.pem

SEAWEED_ACCESS_KEY=aim-prod
SEAWEED_SECRET_KEY=CHANGE_ME_SEAWEED_SECRET_KEY
SEAWEED_BUCKET=aim-attachments
SEAWEED_REGION=us-east-1
SEAWEED_S3_ENDPOINT=http://seaweed-s3:8333

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
GF_USERS_ALLOW_SIGN_UP=false

AIM_API_HOST=api.example.com
AIM_FILES_HOST=CHANGE_ME_FILES_DOMAIN
CADDY_EMAIL=admin@example.com
