# AIM 生产环境变量模板。
# 不要把真实生产 env 提交仓库；部署时复制为 /etc/aim/aim.env 并替换所有 CHANGE_ME。

AIM_ENV_FILE=/etc/aim/aim.env
AIM_CONFIG_DIR=/etc/aim/config
COMPOSE_PROJECT_NAME=aim

POSTGRES_USER=aim_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

AIM_GATEWAY_NODE_ID=0

# 生产建议开启 Nacos 鉴权，并同步 deploy/config/prod.example/*.yaml 中的 Nacos Username/Password。
NACOS_AUTH_ENABLE=true
NACOS_AUTH_TOKEN=CHANGE_ME_NACOS_AUTH_TOKEN_AT_LEAST_32_BYTES
NACOS_AUTH_IDENTITY_KEY=CHANGE_ME_NACOS_IDENTITY_KEY
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME_NACOS_IDENTITY_VALUE

SEAWEED_ACCESS_KEY=aim-prod
SEAWEED_SECRET_KEY=CHANGE_ME_SEAWEED_SECRET_KEY
SEAWEED_BUCKET=aim-attachments
SEAWEED_REGION=us-east-1
SEAWEED_S3_ENDPOINT=http://seaweed-s3:8333

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
GF_USERS_ALLOW_SIGN_UP=false

AIM_API_HOST=api.example.com
AIM_FILES_HOST=CHANGE_ME_FILES_DOMAIN
CADDY_EMAIL=admin@example.com
