syntax = "v1"

info (
	title:  "aim gateway api"
	desc:   "AIM gateway auth proxy API"
	author: "aim"
)

type RegisterRequest {
	Email    string `json:"email" validate:"required,email"`
	Password string `json:"password" validate:"required,min=8"`
	Username string `json:"username" validate:"required"`
	Avatar   string `json:"avatar,optional"`
	DeviceId string `json:"device_id" validate:"required"`
}

type RegisterResponse {
	UserId int64 `json:"user_id"`
}

type LoginRequest {
	Email    string `json:"email" validate:"required,email"`
	Password string `json:"password" validate:"required,min=8"`
	DeviceId string `json:"device_id" validate:"required"`
}

type LoginResponse {
	UserId       int64  `json:"user_id"`
	AccessToken  string `json:"access_token"`
	RefreshToken string `json:"refresh_token"`
	ExpiresAt    int64  `json:"expires_at"`
}

type RefreshRequest {
	RefreshToken string `json:"refresh_token" validate:"required"`
}

type RefreshResponse {
	AccessToken  string `json:"access_token"`
	RefreshToken string `json:"refresh_token"`
	ExpiresAt    int64  `json:"expires_at"`
}

type LogoutResponse {
	Success bool `json:"success"`
}

type GetUserByNameRequest {
	Name string `path:"name" validate:"required"`
}

type GetUserByIdRequest {
	Id int64 `path:"id" validate:"required"`
}

type GetUserByIdResponse {
	User UserInfo `json:"user"`
}

type AddFriendRequest {
	Id int64 `path:"id" validate:"required"`
}

type FriendshipItem {
	UserId      int64  `json:"user_id"`
	FriendId    int64  `json:"friend_id"`
	Status      string `json:"status"`
	CreatedAt   int64  `json:"created_at"`
	UpdatedAt   int64  `json:"updated_at"`
	DisplayName string `json:"display_name,optional"`
	Email       string `json:"email,optional"`
	Avatar      string `json:"avatar,optional"`
}

type AddFriendResponse {
	Friendship FriendshipItem `json:"friendship"`
}

type ListFriendApplicationsResponse {
	Applications []FriendshipItem `json:"applications"`
}

type ListFriendsResponse {
	Friends []FriendshipItem `json:"friends"`
}

type AcceptFriendRequest {
	Id int64 `path:"id" validate:"required"`
}

type AcceptFriendResponse {
	Friendship FriendshipItem `json:"friendship"`
}

type RejectFriendRequest {
	Id int64 `path:"id" validate:"required"`
}

type RejectFriendResponse {
	Friendship FriendshipItem `json:"friendship"`
}

type UserInfo {
	Id          int64  `json:"id"`
	Email       string `json:"email"`
	Status      int32  `json:"status"`
	Nickname    string `json:"nickname"`
	Avatar      string `json:"avatar"`
	DisplayName string `json:"display_name,optional"`
	CreatedAt   int64  `json:"created_at"`
	UpdatedAt   int64  `json:"updated_at"`
}

type GetUserByNameResponse {
	Users []UserListItem `json:"users"`
}

type UserListItem {
	Id          string `json:"id"`
	Nickname    string `json:"nickname"`
	Email       string `json:"email"`
	Avatar      string `json:"avatar"`
	DisplayName string `json:"display_name,optional"`
}

type CreateGroupRequest {
	MemberIds []int64 `json:"member_ids" validate:"required,min=1"`
	Name      string  `json:"name" validate:"required"`
	Avatar    string  `json:"avatar,optional"`
}

type CreateConversationRequest {
	ConversationType string  `json:"conversation_type" validate:"required,oneof=direct group"`
	MemberIds        []int64 `json:"member_ids" validate:"required,min=1"`
	Name             string  `json:"name,optional"`
	Avatar           string  `json:"avatar,optional"`
}

type CreateConversationResponse {
	ConversationId   int64   `json:"conversation_id"`
	ConversationType string  `json:"conversation_type"`
	IsActive         bool    `json:"is_active"`
	CreatedAt        int64   `json:"created_at"`
	MemberIds        []int64 `json:"member_ids"`
	Name             string  `json:"name"`
	Avatar           string  `json:"avatar"`
	CreatorId        int64   `json:"creator_id"`
	DisplayName      string  `json:"display_name,optional"`
}

type GetConversationHistoryRequest {
	Id              int64 `path:"id" validate:"required"`
	CursorCreatedAt int64 `form:"cursor_created_at,optional"`
	CursorId        int64 `form:"cursor_id,optional"`
	Limit           int32 `form:"limit,default=50,optional"`
}

type SenderInfo {
	Name        string `json:"name"`
	Email       string `json:"email"`
	DisplayName string `json:"display_name,optional"`
}

type MessageItem {
	Id             int64                   `json:"id"`
	ConversationId int64                   `json:"conversation_id"`
	SenderId       int64                   `json:"sender_id"`
	SenderInfo     SenderInfo              `json:"sender_info"`
	MessageType    string                  `json:"message_type"`
	Content        string                  `json:"content"`
	ClientMsgId    string                  `json:"client_msg_id"`
	CreatedAt      int64                   `json:"created_at"`
	IsSystem       bool                    `json:"is_system,optional"`
	Mentions       []string                `json:"mentions,optional"`
	ReadDetails    []MessageReadDetailItem `json:"read_details"`
}

type ReadStateItem {
	UserId            int64  `json:"user_id"`
	LastReadMessageId int64  `json:"last_read_message_id"`
	UpdatedAt         int64  `json:"updated_at"`
	Email             string `json:"email,optional"`
	Avatar            string `json:"avatar,optional"`
	DisplayName       string `json:"display_name,optional"`
}

type MessageReadDetailItem {
	UserId            int64  `json:"user_id"`
	IsRead            bool   `json:"is_read"`
	LastReadMessageId int64  `json:"last_read_message_id"`
	UpdatedAt         int64  `json:"updated_at"`
	Email             string `json:"email"`
	Avatar            string `json:"avatar"`
	DisplayName       string `json:"display_name,optional"`
}

type GetConversationHistoryResponse {
	Messages            []MessageItem   `json:"messages"`
	NextCursorCreatedAt int64           `json:"next_cursor_created_at"`
	NextCursorId        int64           `json:"next_cursor_id"`
	HasMore             bool            `json:"has_more"`
	ReadStates          []ReadStateItem `json:"read_states"`
}

type ConversationItem {
	ConversationId   int64   `json:"conversation_id"`
	ConversationType string  `json:"conversation_type"`
	IsActive         bool    `json:"is_active"`
	CreatedAt        int64   `json:"created_at"`
	MemberIds        []int64 `json:"member_ids"`
	Name             string  `json:"name"`
	Avatar           string  `json:"avatar"`
	CreatorId        int64   `json:"creator_id"`
	DisplayName      string  `json:"display_name,optional"`
}

type ListConversationsResponse {
	Conversations []ConversationItem `json:"conversations"`
}

type AddGroupMembersRequest {
	Id        int64   `path:"id" validate:"required"`
	MemberIds []int64 `json:"member_ids" validate:"required,min=1"`
}

type RemoveGroupMemberRequest {
	Id  int64 `path:"id" validate:"required"`
	Uid int64 `path:"uid" validate:"required"`
}

type GrantGroupAdminRequest {
	Id  int64 `path:"id" validate:"required"`
	Uid int64 `path:"uid" validate:"required"`
}

type RevokeGroupAdminRequest {
	Id  int64 `path:"id" validate:"required"`
	Uid int64 `path:"uid" validate:"required"`
}

type TransferGroupOwnerRequest {
	Id     int64 `path:"id" validate:"required"`
	UserId int64 `json:"user_id" validate:"required"`
}

type LeaveGroupRequest {
	Id int64 `path:"id" validate:"required"`
}

type DismissGroupRequest {
	Id int64 `path:"id" validate:"required"`
}

type UpdateGroupInfoRequest {
	Id     int64   `path:"id" validate:"required"`
	Name   *string `json:"name,optional"`
	Avatar *string `json:"avatar,optional"`
}

type GetConversationMembersDetailRequest {
	Id int64 `path:"id" validate:"required"`
}

type MemberDetailItem {
	UserId      int64  `json:"user_id"`
	Email       string `json:"email"`
	Avatar      string `json:"avatar"`
	Role        string `json:"role"`
	JoinedAt    int64  `json:"joined_at"`
	DisplayName string `json:"display_name,optional"`
}

type GetConversationMembersResponse {
	Members []MemberDetailItem `json:"members"`
}

type AddGroupMembersResponse {
	ConversationId   int64   `json:"conversation_id"`
	ConversationType string  `json:"conversation_type"`
	IsActive         bool    `json:"is_active"`
	CreatedAt        int64   `json:"created_at"`
	MemberIds        []int64 `json:"member_ids"`
	Name             string  `json:"name"`
	Avatar           string  `json:"avatar"`
	CreatorId        int64   `json:"creator_id"`
	DisplayName      string  `json:"display_name,optional"`
}

type UpdateGroupInfoResponse {
	ConversationId   int64  `json:"conversation_id"`
	ConversationType string `json:"conversation_type"`
	IsActive         bool   `json:"is_active"`
	Name             string `json:"name"`
	Avatar           string `json:"avatar"`
	CreatorId        int64  `json:"creator_id"`
	CreatedAt        int64  `json:"created_at"`
}

type TransferGroupOwnerResponse {
	ConversationId   int64   `json:"conversation_id"`
	ConversationType string  `json:"conversation_type"`
	IsActive         bool    `json:"is_active"`
	CreatedAt        int64   `json:"created_at"`
	MemberIds        []int64 `json:"member_ids"`
	Name             string  `json:"name"`
	Avatar           string  `json:"avatar"`
	CreatorId        int64   `json:"creator_id"`
	DisplayName      string  `json:"display_name,optional"`
}

type InitAttachmentUploadRequest {
	ConversationId int64  `json:"conversation_id" validate:"required"`
	Kind           string `json:"kind" validate:"required,oneof=image video audio file"`
	OriginalName   string `json:"original_name" validate:"required"`
	Mime           string `json:"mime" validate:"required"`
	Size           int64  `json:"size" validate:"required"`
	Sha256         string `json:"sha256,optional"`
}

type InitAttachmentUploadResponse {
	FileId       string            `json:"file_id"`
	Bucket       string            `json:"bucket"`
	ObjectKey    string            `json:"object_key"`
	UploadUrl    string            `json:"upload_url"`
	UploadMethod string            `json:"upload_method"`
	Headers      map[string]string `json:"headers,optional"`
	ExpiresAt    int64             `json:"expires_at"`
}

type CompleteAttachmentUploadRequest {
	Id     string `path:"id" validate:"required"`
	Sha256 string `json:"sha256,optional"`
}

type GetAttachmentRequest {
	Id string `path:"id" validate:"required"`
}

type DownloadAttachmentRequest {
	Id string `path:"id" validate:"required"`
}

type AttachmentFileInfo {
	FileId             string                 `json:"file_id"`
	OwnerId            int64                  `json:"owner_id"`
	ConversationId     int64                  `json:"conversation_id"`
	Kind               string                 `json:"kind"`
	OriginalName       string                 `json:"original_name"`
	Mime               string                 `json:"mime"`
	Size               int64                  `json:"size"`
	Sha256             string                 `json:"sha256,optional"`
	Status             string                 `json:"status"`
	ParseStatus        string                 `json:"parse_status"`
	Bucket             string                 `json:"bucket"`
	ObjectKey          string                 `json:"object_key"`
	ThumbnailObjectKey string                 `json:"thumbnail_object_key,optional"`
	DurationMs         int64                  `json:"duration_ms,optional"`
	Width              int32                  `json:"width,optional"`
	Height             int32                  `json:"height,optional"`
	Metadata           map[string]interface{} `json:"metadata,optional"`
}

type DownloadAttachmentResponse {
	Url       string            `json:"url"`
	Headers   map[string]string `json:"headers,optional"`
	ExpiresAt int64             `json:"expires_at"`
}

@server (
	prefix: /api/auth
	group:  auth
)
service gateway-api {
	@handler Register
	post /register (RegisterRequest) returns (RegisterResponse)

	@handler Login
	post /login (LoginRequest) returns (LoginResponse)

	@handler Refresh
	post /refresh (RefreshRequest) returns (RefreshResponse)

	@handler Logout
	post /logout returns (LogoutResponse)
}

@server (
	middleware: Auth
	prefix:     /api/attachments
	group:      attachments
)
service gateway-api {
	@handler InitAttachmentUpload
	post /init (InitAttachmentUploadRequest) returns (InitAttachmentUploadResponse)

	@handler GetAttachment
	get /:id (GetAttachmentRequest) returns (AttachmentFileInfo)

	@handler CompleteAttachmentUpload
	post /:id/complete (CompleteAttachmentUploadRequest) returns (AttachmentFileInfo)

	@handler DownloadAttachment
	get /:id/download (DownloadAttachmentRequest) returns (DownloadAttachmentResponse)
}

@server (
	middleware: Auth
	prefix:     /api/users
	group:      users
)
service gateway-api {
	@handler GetUserByName
	get /by-name/:name (GetUserByNameRequest) returns (GetUserByNameResponse)

	@handler GetUserById
	get /by-id/:id (GetUserByIdRequest) returns (GetUserByIdResponse)

	@handler AddFriend
	post /friends/:id (AddFriendRequest) returns (AddFriendResponse)
}

@server (
	middleware: Auth
	prefix:     /api/conversations
	group:      conversations
)
service gateway-api {
	@handler CreateConversation
	post / (CreateConversationRequest) returns (CreateConversationResponse)

	@handler CreateGroup
	post /group (CreateGroupRequest) returns (CreateConversationResponse)

	@handler GetConversationHistory
	get /history/:id (GetConversationHistoryRequest) returns (GetConversationHistoryResponse)

	@handler ListConversations
	get / returns (ListConversationsResponse)

	@handler GetConversationMembers
	get /:id/members (GetConversationMembersDetailRequest) returns (GetConversationMembersResponse)

	@handler AddGroupMembers
	post /:id/members (AddGroupMembersRequest) returns (AddGroupMembersResponse)

	@handler RemoveGroupMember
	delete /:id/members/:uid (RemoveGroupMemberRequest)

	@handler GrantGroupAdmin
	post /:id/members/:uid/admin (GrantGroupAdminRequest)

	@handler RevokeGroupAdmin
	delete /:id/members/:uid/admin (RevokeGroupAdminRequest)

	@handler TransferGroupOwner
	post /:id/owner (TransferGroupOwnerRequest) returns (TransferGroupOwnerResponse)

	@handler LeaveGroup
	post /:id/leave (LeaveGroupRequest)

	@handler DismissGroup
	delete /:id (DismissGroupRequest)

	@handler UpdateGroupInfo
	put /:id (UpdateGroupInfoRequest) returns (UpdateGroupInfoResponse)
}

@server (
	middleware: Auth
	prefix:     /api/friends
	group:      friends
)
service gateway-api {
	@handler ListFriendApplications
	get /applications returns (ListFriendApplicationsResponse)

	@handler ListFriends
	get /me returns (ListFriendsResponse)

	@handler AcceptFriend
	post /accept/:id (AcceptFriendRequest) returns (AcceptFriendResponse)

	@handler RejectFriend
	post /reject/:id (RejectFriendRequest) returns (RejectFriendResponse)
}

type PresenceItem {
	UserId      int64  `json:"user_id"`
	Status      string `json:"status"`
	UpdatedAt   int64  `json:"updated_at"`
	DisplayName string `json:"display_name,optional"`
}

type GetFriendsPresenceResponse {
	Presences []PresenceItem `json:"presences"`
}

@server (
	middleware: Auth
	prefix:     /api/presence
	group:      presence
)
service gateway-api {
	@handler GetFriendsPresence
	get /friends returns (GetFriendsPresenceResponse)
}

// ===== Bot OpenAPI =====
//
// All routes below are authenticated via BotAuth, which expects a header of
// the form `Authorization: Bot <token>`. The token format is documented in
// app/shared/bottoken. BotAuth resolves the token to a bot_user_id via
// logic.BotService.ValidateBotToken and rejects:
//   - missing/malformed tokens (CodeBotTokenInvalid → HTTP 401)
//   - revoked or expired tokens (CodeBotTokenRevoked → HTTP 401)
//   - tokens belonging to disabled bots (CodeBotDisabled → HTTP 401)
type BotMe {
	BotUserId string   `json:"bot_user_id"`
	Nickname  string   `json:"nickname"`
	Avatar    string   `json:"avatar"`
	Status    int32    `json:"status"`
	Scopes    []string `json:"scopes"`
}

type BotMeResponse {
	Bot BotMe `json:"bot"`
}

type BotConversationItem {
	ConversationId   string `json:"conversation_id"`
	ConversationType string `json:"conversation_type"`
	Name             string `json:"name"`
	Avatar           string `json:"avatar"`
	CreatedAt        int64  `json:"created_at"`
}

type BotListConversationsResponse {
	Conversations []BotConversationItem `json:"conversations"`
}

type BotSendMessageRequest {
	ConversationId string   `json:"conversation_id" validate:"required"`
	MessageType    string   `json:"message_type" validate:"required,max=32"`
	Content        string   `json:"content" validate:"required"`
	ClientMsgId    string   `json:"client_msg_id" validate:"required"`
	Mentions       []string `json:"mentions,optional"`
}

type BotSendMessageResponse {
	MessageId   string `json:"message_id"`
	ClientMsgId string `json:"client_msg_id"`
	AcceptedAt  int64  `json:"accepted_at"`
}

type BotGetConversationHistoryRequest {
	Id              string `path:"id" validate:"required"`
	CursorCreatedAt int64  `form:"cursor_created_at,optional"`
	CursorId        string `form:"cursor_id,optional"`
	Limit           int32  `form:"limit,default=50,optional"`
}

type BotSenderInfo {
	Name        string `json:"name"`
	Email       string `json:"email"`
	DisplayName string `json:"display_name,optional"`
}

type BotMessageReadDetailItem {
	UserId            string `json:"user_id"`
	IsRead            bool   `json:"is_read"`
	LastReadMessageId string `json:"last_read_message_id"`
	UpdatedAt         int64  `json:"updated_at"`
	Email             string `json:"email"`
	Avatar            string `json:"avatar"`
	DisplayName       string `json:"display_name,optional"`
}

type BotMessageItem {
	Id             string                     `json:"id"`
	ConversationId string                     `json:"conversation_id"`
	SenderId       string                     `json:"sender_id"`
	SenderInfo     BotSenderInfo              `json:"sender_info"`
	MessageType    string                     `json:"message_type"`
	Content        string                     `json:"content"`
	ClientMsgId    string                     `json:"client_msg_id"`
	CreatedAt      int64                      `json:"created_at"`
	IsSystem       bool                       `json:"is_system,optional"`
	Mentions       []string                   `json:"mentions,optional"`
	ReadDetails    []BotMessageReadDetailItem `json:"read_details"`
}

type BotReadStateItem {
	UserId            string `json:"user_id"`
	LastReadMessageId string `json:"last_read_message_id"`
	UpdatedAt         int64  `json:"updated_at"`
	Email             string `json:"email,optional"`
	Avatar            string `json:"avatar,optional"`
	DisplayName       string `json:"display_name,optional"`
}

type BotGetConversationHistoryResponse {
	Messages            []BotMessageItem   `json:"messages"`
	NextCursorCreatedAt int64              `json:"next_cursor_created_at"`
	NextCursorId        string             `json:"next_cursor_id"`
	HasMore             bool               `json:"has_more"`
	ReadStates          []BotReadStateItem `json:"read_states"`
}

type BotGetConversationMembersRequest {
	Id string `path:"id" validate:"required"`
}

type BotMemberDetailItem {
	UserId      string `json:"user_id"`
	Email       string `json:"email"`
	Avatar      string `json:"avatar"`
	Role        string `json:"role"`
	JoinedAt    int64  `json:"joined_at"`
	DisplayName string `json:"display_name,optional"`
}

type BotGetConversationMembersResponse {
	Members []BotMemberDetailItem `json:"members"`
}

type BotMarkReadRequest {
	Id                string `path:"id" validate:"required"`
	LastReadMessageId string `json:"last_read_message_id" validate:"required"`
}

type BotMarkReadResponse {
	ReadState BotReadStateItem `json:"read_state"`
}

type BotListReadStatesRequest {
	Id string `path:"id" validate:"required"`
}

type BotListReadStatesResponse {
	ReadStates []BotReadStateItem `json:"read_states"`
}

type BotDownloadAttachmentRequest {
	Id string `path:"id" validate:"required"`
}

type BotDownloadAttachmentResponse {
	Url       string            `json:"url"`
	Headers   map[string]string `json:"headers,optional"`
	ExpiresAt int64             `json:"expires_at"`
}

type BotWebhookConfig {
	Url       string   `json:"url"`
	Events    []string `json:"events"`
	Enabled   bool     `json:"enabled"`
	UpdatedAt int64    `json:"updated_at"`
}

type BotGetWebhookResponse {
	Configured bool             `json:"configured"`
	Webhook    BotWebhookConfig `json:"webhook"`
}

type BotSetWebhookRequest {
	Url     string   `json:"url" validate:"required,url"`
	Events  []string `json:"events,optional"`
	Enabled *bool    `json:"enabled,optional"`
	// Secret is the HMAC-SHA256 signing secret. Leave blank to keep the
	// existing secret on update; required when creating a new webhook.
	Secret string `json:"secret,optional"`
	// RotateSecret, when true, generates a fresh secret and returns its
	// plaintext exactly once in the response. Mutually exclusive with Secret.
	RotateSecret bool `json:"rotate_secret,optional"`
}

type BotSetWebhookResponse {
	Webhook BotWebhookConfig `json:"webhook"`
	// PlaintextSecret is populated only when a secret was created or rotated
	// in this request. The server never persists or returns it again.
	PlaintextSecret string `json:"plaintext_secret,omitempty"`
}

type BotDeleteWebhookResponse {
	Deleted bool `json:"deleted"`
}

@server (
	middleware: BotAuth
	prefix:     /api/bot/v1
	group:      bot
)
service gateway-api {
	@handler BotGetMe
	get /me returns (BotMeResponse)

	@handler BotListConversations
	get /conversations returns (BotListConversationsResponse)

	@handler BotGetConversationHistory
	get /conversations/:id/history (BotGetConversationHistoryRequest) returns (BotGetConversationHistoryResponse)

	@handler BotGetConversationMembers
	get /conversations/:id/members (BotGetConversationMembersRequest) returns (BotGetConversationMembersResponse)

	@handler BotMarkRead
	post /conversations/:id/read-receipt (BotMarkReadRequest) returns (BotMarkReadResponse)

	@handler BotListReadStates
	get /conversations/:id/read-states (BotListReadStatesRequest) returns (BotListReadStatesResponse)

	@handler BotSendMessage
	post /messages (BotSendMessageRequest) returns (BotSendMessageResponse)

	@handler BotGetWebhook
	get /webhook returns (BotGetWebhookResponse)

	@handler BotSetWebhook
	put /webhook (BotSetWebhookRequest) returns (BotSetWebhookResponse)

	@handler BotDeleteWebhook
	delete /webhook returns (BotDeleteWebhookResponse)

	@handler BotDownloadAttachment
	get /attachments/:id/download (BotDownloadAttachmentRequest) returns (BotDownloadAttachmentResponse)
}

